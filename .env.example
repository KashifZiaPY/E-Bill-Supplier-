# APP_PIN: Security PIN for the Anwar Traders billing app (e.g. 1234 or your custom 4-6 digit PIN)
APP_PIN="1234"

# GAS_URL: The Google Apps Script Web App exec URL (from your Google Sheet deployment)
# Example: https://script.google.com/macros/s/AKfycbx.../exec
GAS_URL=""

# GAS_API_KEY: Secret key configured in Apps Script Script Properties
GAS_API_KEY=""

# GEMINI_API_KEY: Required for Gemini AI API calls (if applicable)
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

